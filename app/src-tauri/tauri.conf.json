{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustySteamless",
  "version": "0.0.1",
  "identifier": "com.notwinterdust.rusty-steamless",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustySteamless",
        "width": 1100,
        "height": 560,
        "minWidth": 720,
        "minHeight": 420,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}